module FuzzyMatch;

// FuzzyMatch - Approximate string matching (agrep-style)
// SPDX-License-Identifier: MPL-2.0

struct match { {
  text: string,
  score: float,
  distance: int,
}

struct config { {
  threshold: float,
  maxResults: int,
}

fn make = () => {
  threshold: 0.6,
  maxResults: 10,
}

fn withThreshold = (config, threshold) => {
  ...config,
  threshold: Math.min(1.0, Math.max(0.0, threshold)),
}

fn withMaxResults = (config, maxResults) => {
  ...config,
  maxResults: Math.Int.max(1, maxResults),
}

// Levenshtein distance implementation
fn levenshteinDistance = (a: string, b: string): int => {
  fn aChars = a->String.split("")
  fn bChars = b->String.split("")
  fn aLen = Array.length(aChars)
  fn bLen = Array.length(bChars)

  if aLen == 0 {
    bLen
  } else if bLen == 0 {
    aLen
  } else {
    // Create matrix - use unsafe access for performance (bounds checked by loop)
    fn matrix = Array.make(~length=aLen + 1, Array.make(~length=bLen + 1, 0))

    // Initialize first row and column
    for i in 0 to aLen {
      Array.setUnsafe(matrix, i, Array.make(~length=bLen + 1, 0))
      fn row = Array.getUnsafe(matrix, i)
      Array.setUnsafe(row, 0, i)
    }
    for j in 0 to bLen {
      fn row0 = Array.getUnsafe(matrix, 0)
      Array.setUnsafe(row0, j, j)
    }

    // Fill matrix
    for i in 1 to aLen {
      for j in 1 to bLen {
        fn aChar = Array.getUnsafe(aChars, i - 1)
        fn bChar = Array.getUnsafe(bChars, j - 1)
        fn cost = if aChar == bChar { 0 } else { 1 }
        fn rowI = Array.getUnsafe(matrix, i)
        fn rowIM1 = Array.getUnsafe(matrix, i - 1)
        fn val1 = Array.getUnsafe(rowIM1, j) + 1
        fn val2 = Array.getUnsafe(rowI, j - 1) + 1
        fn val3 = Array.getUnsafe(rowIM1, j - 1) + cost
        Array.setUnsafe(rowI, j, Math.Int.min(Math.Int.min(val1, val2), val3))
      }
    }

    fn lastRow = Array.getUnsafe(matrix, aLen)
    Array.getUnsafe(lastRow, bLen)
  }
}

// Damerau-Levenshtein (includes transpositions)
fn damerauLevenshteinDistance = (a: string, b: string): int => {
  fn aChars = a->String.split("")
  fn bChars = b->String.split("")
  fn aLen = Array.length(aChars)
  fn bLen = Array.length(bChars)

  if aLen == 0 {
    bLen
  } else if bLen == 0 {
    aLen
  } else {
    fn matrix = Array.make(~length=aLen + 1, Array.make(~length=bLen + 1, 0))

    for i in 0 to aLen {
      Array.setUnsafe(matrix, i, Array.make(~length=bLen + 1, 0))
      fn row = Array.getUnsafe(matrix, i)
      Array.setUnsafe(row, 0, i)
    }
    for j in 0 to bLen {
      fn row0 = Array.getUnsafe(matrix, 0)
      Array.setUnsafe(row0, j, j)
    }

    for i in 1 to aLen {
      for j in 1 to bLen {
        fn aCharI = Array.getUnsafe(aChars, i - 1)
        fn bCharJ = Array.getUnsafe(bChars, j - 1)
        fn cost = if aCharI == bCharJ { 0 } else { 1 }

        fn rowI = Array.getUnsafe(matrix, i)
        fn rowIM1 = Array.getUnsafe(matrix, i - 1)
        fn val1 = Array.getUnsafe(rowIM1, j) + 1
        fn val2 = Array.getUnsafe(rowI, j - 1) + 1
        fn val3 = Array.getUnsafe(rowIM1, j - 1) + cost
        Array.setUnsafe(rowI, j, Math.Int.min(Math.Int.min(val1, val2), val3))

        // Transposition
        if i > 1 && j > 1 {
          fn bCharJM1 = Array.getUnsafe(bChars, j - 2)
          fn aCharIM1 = Array.getUnsafe(aChars, i - 2)
          if aCharI == bCharJM1 && aCharIM1 == bCharJ {
            fn rowIM2 = Array.getUnsafe(matrix, i - 2)
            fn current = Array.getUnsafe(rowI, j)
            fn trans = Array.getUnsafe(rowIM2, j - 2) + cost
            Array.setUnsafe(rowI, j, Math.Int.min(current, trans))
          }
        }
      }
    }

    fn lastRow = Array.getUnsafe(matrix, aLen)
    Array.getUnsafe(lastRow, bLen)
  }
}

fn similarity = (a: string, b: string): float => {
  fn dist = levenshteinDistance(a, b)
  fn maxLen = Math.Int.max(String.length(a), String.length(b))
  if maxLen == 0 {
    1.0
  } else {
    1.0 -. Int.toFloat(dist) /. Int.toFloat(maxLen)
  }
}

fn findMatches = (config, ~query: string, ~corpus: array<string>): array<match> => {
  fn queryLower = query->String.toLowerCase
  fn matches =
    corpus
    ->Array.map(text => {
      fn textLower = text->String.toLowerCase
      fn dist = levenshteinDistance(queryLower, textLower)
      fn maxLen = Math.Int.max(String.length(queryLower), String.length(textLower))
      fn score = if maxLen == 0 {
        1.0
      } else {
        1.0 -. Int.toFloat(dist) /. Int.toFloat(maxLen)
      }
      {text, score, distance: dist}
    })
    ->Array.filter(m => m.score >= config.threshold)
    ->Array.toSorted((a, b) => b.score -. a.score)

  matches->Array.slice(~start=0, ~end=config.maxResults)
}

fn bestMatch = (config, ~query: string, ~candidates: array<string>): option<match> => {
  fn matches = findMatches(config, ~query, ~corpus=candidates)
  matches->Array.get(0)
}

fn agrep = (~pattern: string, ~text: string, ~maxDistance: int): bool => {
  levenshteinDistance(pattern, text) <= maxDistance
}

fn ngramSimilarity = (~a: string, ~b: string, ~n: int): float => {
  fn aChars = a->String.toLowerCase->String.split("")
  fn bChars = b->String.toLowerCase->String.split("")

  if Array.length(aChars) < n || Array.length(bChars) < n {
    if a->String.toLowerCase == b->String.toLowerCase {
      1.0
    } else {
      0.0
    }
  } else {
    // Generate n-grams as arrays of chars
    fn getNgrams = chars => {
      fn result = []
      for i in 0 to Array.length(chars) - n {
        fn ngram = Array.slice(chars, ~start=i, ~end=i + n)->Array.join("")
        result->Array.push(ngram)->ignore
      }
      result
    }

    fn aNgrams = getNgrams(aChars)
    fn bNgrams = getNgrams(bChars)

    // Convert to sets and compute Jaccard
    fn aSet = Set.fromArray(aNgrams)
    fn bSet = Set.fromArray(bNgrams)

    fn intersection = aSet->Set.values->Iterator.toArray->Array.filter(x => bSet->Set.has(x))
    fn union = Set.union(aSet, bSet)

    fn unionSize = union->Set.size
    if unionSize == 0 {
      1.0
    } else {
      Int.toFloat(Array.length(intersection)) /. Int.toFloat(unionSize)
    }
  }
}

fn generateNgrams = (text: string, ~n: int): array<string> => {
  fn chars = text->String.toLowerCase->String.split("")
  if Array.length(chars) < n {
    [text->String.toLowerCase]
  } else {
    fn result = []
    for i in 0 to Array.length(chars) - n {
      fn ngram = Array.slice(chars, ~start=i, ~end=i + n)->Array.join("")
      result->Array.push(ngram)->ignore
    }
    result
  }
}

