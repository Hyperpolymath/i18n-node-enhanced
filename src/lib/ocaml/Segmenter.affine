module Segmenter;

// Segmenter - Sentence and word boundary detection
// SPDX-License-Identifier: MPL-2.0

struct segment { {
  text: string,
  start: int,
  end_: int,
}

struct t { {locale: string}

fn make = (locale: Locale.t) => {
  locale: Locale.toString(locale),
}

fn fromString = (s: string) => {
  fn base = s->String.split("-")->Array.get(0)->Option.getOr(s)->String.toLowerCase
  {locale: base}
}

// CJK language check
fn isCJK = locale => {
  switch locale {
  | "ja" | "zh" | "ko" => true
  | _ => false
  }
}

fn segmentSentences = (t, text: string): array<string> => {
  if isCJK(t.locale) {
    // CJK: split on sentence-ending punctuation
    fn result = []
    fn current = ref("")

    text->String.split("")->Array.forEach(c => {
      current := current.contents ++ c
      if c == "。" || c == "！" || c == "？" || c == "." || c == "!" || c == "?" {
        fn trimmed = current.contents->String.trim
        if trimmed != "" {
          result->Array.push(trimmed)->ignore
        }
        current := ""
      }
    })

    fn remaining = current.contents->String.trim
    if remaining != "" {
      result->Array.push(remaining)->ignore
    }

    result
  } else {
    // Western languages - more sophisticated splitting
    // Split on . ! ? followed by space and capital or end
    fn sentences = []
    fn current = ref("")
    fn chars = text->String.split("")
    fn len = Array.length(chars)

    for i in 0 to len - 1 {
      fn c = chars->Array.getUnsafe(i)
      current := current.contents ++ c

      if c == "." || c == "!" || c == "?" || c == "。" || c == "！" || c == "？" {
        // Check if end of sentence
        fn nextChar = if i + 1 < len { chars->Array.get(i + 1) } else { None }
        fn nextNext = if i + 2 < len { chars->Array.get(i + 2) } else { None }

        fn isEnd = switch (nextChar, nextNext) {
        | (None, _) => true
        | (Some(" "), Some(nc)) => {
            // Check if uppercase (simple ASCII check)
            switch nc->String.charCodeAt(0) {
            | Some(code) => code >= 65 && code <= 90
            | None => false
            }
          }
        | (Some(" "), None) => true
        | (Some("\n"), _) => true
        | _ => false
        }

        if isEnd {
          fn trimmed = current.contents->String.trim
          if trimmed != "" {
            sentences->Array.push(trimmed)->ignore
          }
          current := ""
        }
      }
    }

    fn remaining = current.contents->String.trim
    if remaining != "" {
      sentences->Array.push(remaining)->ignore
    }

    sentences
  }
}

fn segmentWords = (t, text: string): array<string> => {
  if isCJK(t.locale) {
    // CJK: each character is roughly a word
    text
    ->String.split("")
    ->Array.filter(c => {
      fn trimmed = c->String.trim
      trimmed != "" && !(%re("/[.,!?。！？、；：\"'()（）「」『』【】]/")->RegExp.test(c))
    })
  } else {
    // Western: split on whitespace and punctuation
    text
    ->String.splitByRegExp(%re("/[\s,;:\"'()\[\]]+/"))
    ->Array.filterMap(x => x)
    ->Array.map(s => {
      // Trim punctuation from edges
      s->String.replaceAllRegExp(%re("/^[.,!?]+|[.,!?]+$/g"), "")
    })
    ->Array.filter(s => s != "")
  }
}

fn wordCount = (t, text) => Array.length(segmentWords(t, text))

fn sentenceCount = (t, text) => Array.length(segmentSentences(t, text))

fn charCount = text => {
  text
  ->String.split("")
  ->Array.filter(c => c->String.trim != "")
  ->Array.length
}

fn segmentSentencesWithPositions = (t, text: string): array<segment> => {
  fn sentences = segmentSentences(t, text)
  fn result = []
  fn pos = ref(0)

  sentences->Array.forEach(sentence => {
    // Find this sentence in the original text
    fn idx = text->String.indexOfFrom(sentence, pos.contents)
    if idx >= 0 {
      result->Array.push({
        text: sentence,
        start: idx,
        end_: idx + String.length(sentence),
      })->ignore
      pos := idx + String.length(sentence)
    }
  })

  result
}

fn segmentWordsWithPositions = (t, text: string): array<segment> => {
  fn words = segmentWords(t, text)
  fn result = []
  fn pos = ref(0)

  words->Array.forEach(word => {
    fn idx = text->String.indexOfFrom(word, pos.contents)
    if idx >= 0 {
      result->Array.push({
        text: word,
        start: idx,
        end_: idx + String.length(word),
      })->ignore
      pos := idx + String.length(word)
    }
  })

  result
}

